# ==============================================================================
# ZF Store Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit real credentials, database passwords, or secret keys to git.
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/zf_store?sslmode=disable"

# ------------------------------------------------------------------------------
# Site Canonical Base URL (Required for Production SEO metadata & sitemap)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://zfstore.com"

# ------------------------------------------------------------------------------
# Amazon Associates Configuration
# Official tracking tag provided by Amazon Associates portal.
# If left empty, affiliate parameter injection is disabled and direct URLs are preserved.
# NEVER commit a real affiliate tag as a secret.
# ------------------------------------------------------------------------------
AMAZON_ASSOCIATE_TAG=""

# Authentication & Session Secret (Required for production)
# Generate via: openssl rand -base64 32
AUTH_SECRET="your-32-character-random-secret-key-change-in-production"

# Optional Initial Admin User Bootstrap
# INITIAL_ADMIN_EMAIL="admin@example.com"
# INITIAL_ADMIN_PASSWORD="change-me-in-production"
# INITIAL_ADMIN_NAME="Store Administrator"

# ------------------------------------------------------------------------------
# Cloudinary — Product Image Storage
# Sign up at https://cloudinary.com (free tier available)
# Find these values in Cloudinary Dashboard → Settings → API Keys
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
# SECURITY: CLOUDINARY_API_SECRET is STRICTLY server-side. Never use NEXT_PUBLIC_.
CLOUDINARY_API_SECRET="your-api-secret"
