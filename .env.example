# ==============================================================================
# ZF Store Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit real credentials, database passwords, or secret keys to git.
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/zf_store?sslmode=disable"

# Future Amazon Associates Tag (Will be supplied by client)
# NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=""
