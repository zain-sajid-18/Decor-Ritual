# ==============================================================================
# ZF Store — Environment Variables Reference
# ==============================================================================
#
# LOCAL DEV:    Copy this file to .env and fill in your values.
# VERCEL:       Add each variable in Project → Settings → Environment Variables.
#               The .env file is git-ignored and never deployed.
#
# Required variables are marked [REQUIRED].
# Optional variables are marked [OPTIONAL].
# ==============================================================================

# ------------------------------------------------------------------------------
# [REQUIRED] Database — Neon PostgreSQL
# Get from: https://console.neon.tech → Your Project → Connection Details
# Use the "pooled" connection string for serverless/Vercel deployments.
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST/neondb?sslmode=require&channel_binding=require"

# ------------------------------------------------------------------------------
# [REQUIRED] Auth Secret — Session JWT Signing Key
# Must be a random 32+ character string. NEVER reuse across environments.
# Generate one at: https://generate-secret.vercel.app/32
# ------------------------------------------------------------------------------
AUTH_SECRET="your-32-character-random-secret-here"

# ------------------------------------------------------------------------------
# [REQUIRED] Canonical Site URL
# Set to your Vercel domain (e.g. https://decor-ritual.vercel.app)
# Used for SEO metadata, Open Graph URLs, sitemap, and robots.txt.
# Vercel's VERCEL_URL is used as a fallback if this is unset.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://your-site.vercel.app"

# ------------------------------------------------------------------------------
# [REQUIRED] Cloudinary — Product Image Storage
# Sign up at: https://cloudinary.com (free tier available)
# Values found in: Cloudinary Dashboard → Settings → API Keys
# SECURITY: CLOUDINARY_API_SECRET is server-side only. Never use NEXT_PUBLIC_.
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ------------------------------------------------------------------------------
# [OPTIONAL] Amazon Associates Affiliate Tag
# If set, this tag is appended to all outbound Amazon product links.
# Get from: https://affiliate-program.amazon.com → Manage Tracking IDs
# Leave empty ("") to use direct Amazon URLs without affiliate tracking.
# ------------------------------------------------------------------------------
AMAZON_ASSOCIATE_TAG=""

# ------------------------------------------------------------------------------
# [OPTIONAL] Bootstrap Initial Admin Account
# Only used during first-time DB setup to seed an admin user.
# Remove or comment out after initial setup for security.
# ------------------------------------------------------------------------------
# INITIAL_ADMIN_EMAIL="admin@yourdomain.com"
# INITIAL_ADMIN_PASSWORD="change-me-immediately"
# INITIAL_ADMIN_NAME="Store Administrator"